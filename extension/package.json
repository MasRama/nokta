{
  "name": "nokta-extension",
  "version": "0.6.0",
  "private": true,
  "description": "GNOME Shell extension for Nokta, a dynamic island for the desktop",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MasRama/nokta.git",
    "directory": "extension"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "gen-contracts": "node scripts/gen-contracts.mjs",
    "build": "npm run gen-contracts && tsc -p tsconfig.json",
    "check": "npm run gen-contracts && tsc -p tsconfig.json --noEmit && node scripts/check-contracts.mjs",
    "lint": "eslint .",
    "test": "node -e \"require('fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json && node --test \".test-build/tests/**/*.test.js\"",
    "pack": "sh scripts/pack.sh"
  },
