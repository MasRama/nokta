<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Nokta contract v1. Object path: /io/nokta/Downloads. Bus name: io.nokta.Nokta. -->
<node>
  <interface name="io.nokta.Downloads1">
    <!--
      A file finished downloading into the download folder ([downloads]
      folder, else the system's). uri is the file's file:// URI, name its file
      name, icon a themed icon name for its kind, size its length in bytes.
      thumbnail is the path of a small PNG of a picture, empty for other
      files.
    -->
    <signal name="Finished">
      <arg name="uri" type="s"/>
      <arg name="name" type="s"/>
      <arg name="icon" type="s"/>
      <arg name="size" type="t"/>
      <arg name="thumbnail" type="s"/>
    </signal>
  </interface>
</node>
