<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Nokta contract v1. Object path: /io/nokta/Clipboard. Bus name: io.nokta.Nokta. -->
<node>
  <interface name="io.nokta.Clipboard1">
    <!--
      Keeps one copy. kind is "text" (text, image empty) or "image" (image is
      a PNG, text empty). Blank text, text over 1 MiB, an image that is not a
      PNG or is over 8 MiB, and every copy while Paused or while [clipboard]
      enabled is false, are ignored. Content already kept moves to the top
      instead. Unpinned entries beyond [clipboard] max_items go, oldest
      first. Nothing is written to disk but image thumbnails.
    -->
    <method name="Add">
      <arg name="kind" type="s" direction="in"/>
      <arg name="text" type="s" direction="in"/>
      <arg name="image" type="ay" direction="in"/>
    </method>
    <!-- One entry's content, as Add took it. Fails with InvalidArgs for an unknown id. -->
    <method name="Get">
      <arg name="id" type="s" direction="in"/>
      <arg name="kind" type="s" direction="out"/>
      <arg name="text" type="s" direction="out"/>
      <arg name="image" type="ay" direction="out"/>
    </method>
    <!-- Pins or unpins an entry; a pinned one is never evicted or cleared. An unknown id is ignored. -->
    <method name="Pin">
      <arg name="id" type="s" direction="in"/>
      <arg name="pinned" type="b" direction="in"/>
    </method>
    <!-- Removes one entry, pinned or not. An unknown id is ignored. -->
    <method name="Remove">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Removes every entry that is not pinned. -->
    <method name="Clear"/>
    <!-- Stops or resumes keeping copies; noktad starts unpaused. -->
    <method name="SetPaused">
      <arg name="paused" type="b" direction="in"/>
    </method>
    <!--
      The entries, newest first: id, kind ("text" or "image"), a one-line
      preview (an image's "width × height"), the path of a PNG thumbnail of
      at most 128 px for an image (empty for text, and for a moment after an
      image is added), pinned, and when it was last copied in microseconds
      since the Unix epoch. In memory only: empty when noktad starts, and
      emptied when [clipboard] enabled turns false.
    -->
    <property name="Items" type="a(ssssbx)" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="Paused" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
  </interface>
</node>
