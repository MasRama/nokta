<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Nokta contract v1. Object path: /io/nokta/Settings. Bus name: io.nokta.Nokta. -->
<node>
  <interface name="io.nokta.Settings1">
    <!-- The [appearance] table of config.toml. -->
    <property name="Appearance" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [behavior] table of config.toml. -->
    <property name="Behavior" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [media] table of config.toml. -->
    <property name="Media" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [lyrics] table of config.toml. -->
    <property name="Lyrics" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [timer] table of config.toml. -->
    <property name="Timer" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [notifications] table of config.toml. -->
    <property name="Notifications" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [activities] table of config.toml. -->
    <property name="Activities" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [weather] table of config.toml. -->
    <property name="Weather" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [calendar] table of config.toml. -->
    <property name="Calendar" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [clipboard] table of config.toml. -->
    <property name="Clipboard" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [downloads] table of config.toml. -->
    <property name="Downloads" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [system] table of config.toml. -->
    <property name="System" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [updates] table of config.toml. -->
    <property name="Updates" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The [home] table of config.toml. Its lists are "as". -->
    <property name="Home" type="a{sv}" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!--
      The picture theme's image ([appearance] picture), scaled down and
      blurred into the cache as a PNG; empty when no picture is set or it
      cannot be read.
    -->
    <property name="PicturePath" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The picture's vivid color as "#rrggbb", or empty when it has none. -->
    <property name="PictureColor" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The mean color of the picture's top half as "#rrggbb", or empty. -->
    <property name="PictureTone" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!--
      Changes one key of config.toml and saves it, keeping its comments. table
      is "appearance", "behavior", "media", "lyrics", "timer", "notifications",
      "activities", "weather", "calendar", "clipboard", "downloads", "system",
      "updates" or "home"; a list such as home.tiles is sent as "as". Fails
      with InvalidArgs, and writes nothing, for an unknown key, a value of the
      wrong type or a value the config does not accept. The new value is
      published like any edit.
    -->
    <method name="Set">
      <arg name="table" type="s" direction="in"/>
      <arg name="key" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <!-- Replaces config.toml with the commented default file. -->
    <method name="Reset"/>
  </interface>
</node>
