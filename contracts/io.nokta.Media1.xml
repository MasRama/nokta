<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!-- Nokta contract v1. Object path: /io/nokta/Media. Bus name: io.nokta.Nokta. -->
<node>
  <interface name="io.nokta.Media1">
    <!-- True when an active player exists. -->
    <property name="Available" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Identity of the active player, e.g. "Spotify". -->
    <property name="PlayerName" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Id of the active player (its unique bus name), empty when none. -->
    <property name="PlayerId" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Every playing or paused player as (id, display name), in the order
         they appeared. -->
    <property name="Players" type="a(ss)" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- "Playing", "Paused" or "Stopped". -->
    <property name="PlaybackStatus" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="Title" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="Artists" type="as" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="Album" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Track length in microseconds, 0 when unknown. -->
    <property name="LengthUs" type="x" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Local path of the cover image, empty when there is none. -->
    <property name="ArtPath" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- "#rrggbb" derived from the cover, empty when there is none. -->
    <property name="AccentColor" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Local path of the cover downsized to 160 px and blurred, to show
         behind the player; empty when there is no cover. -->
    <property name="BackdropPath" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Position snapshot in microseconds. -->
    <property name="PositionUs" type="x" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- CLOCK_MONOTONIC in microseconds when PositionUs was read. -->
    <property name="PositionTimestampUs" type="x" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- Playback rate. -->
    <property name="Rate" type="d" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="CanPlayPause" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="CanGoNext" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="CanGoPrevious" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <property name="CanSeek" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- The player's shuffle; false when it has none (CanShuffle). -->
    <property name="Shuffle" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- "None", "Track" or "Playlist"; "None" when it has none (CanLoop). -->
    <property name="LoopStatus" type="s" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- True when the player publishes MPRIS Shuffle and can be controlled. -->
    <property name="CanShuffle" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <!-- True when the player publishes MPRIS LoopStatus and can be controlled. -->
    <property name="CanLoop" type="b" access="read">
      <annotation name="org.freedesktop.DBus.Property.EmitsChangedSignal" value="true"/>
    </property>
    <method name="PlayPause"/>
    <method name="Next"/>
    <method name="Previous"/>
    <!-- Absolute seek within the current track. -->
    <method name="SetPosition">
      <arg name="position_us" type="x" direction="in"/>
    </method>
    <!-- Re-read the position from the player and publish a new snapshot. -->
    <method name="RefreshPosition"/>
    <!-- Make a player from Players the active one. It stays active until
         another player starts playing or it stops. Unknown ids are ignored. -->
    <method name="SelectPlayer">
      <arg name="id" type="s" direction="in"/>
    </method>
    <!-- Turns the active player's shuffle on or off; ignored without CanShuffle. -->
    <method name="SetShuffle">
      <arg name="shuffle" type="b" direction="in"/>
    </method>
    <!-- Sets the active player's repeat to "None", "Track" or "Playlist";
         ignored without CanLoop. Any other value fails with InvalidArgs. -->
    <method name="SetLoopStatus">
      <arg name="status" type="s" direction="in"/>
    </method>
  </interface>
</node>
