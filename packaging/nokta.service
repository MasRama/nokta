[Unit]
Description=Nokta daemon (media, lyrics and settings for the Nokta notch)
Documentation=https://github.com/MasRama/nokta
PartOf=graphical-session.target
# A panic stops noktad; keep starting it, ever more slowly, instead of giving up.
StartLimitIntervalSec=0

[Service]
Type=dbus
BusName=io.nokta.Nokta
ExecStart=@BINDIR@/noktad
Restart=on-failure
RestartSec=2
RestartSteps=5
RestartMaxDelaySec=60
