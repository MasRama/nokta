{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nokta",
  "mainBinaryName": "Nokta",
  "version": "../package.json",
  "identifier": "io.nokta.Nokta",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Nokta",
    "homepage": "https://github.com/MasRama/nokta",
    "license": "GPL-3.0-or-later",
    "shortDescription": "A dynamic island for the desktop",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer.nsh"
      }
    }
  }
}
